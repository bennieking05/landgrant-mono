#!/bin/bash

# LandGrant Pre-Push Hook
# Enforces quality gate before push:
#   1. Backend ruff + black check
#   2. Backend pytest (fast subset)
#   3. Frontend smoke Playwright tests
#
# To install: ./scripts/install-githooks.sh
# To bypass (emergency only): git push --no-verify

set -e

echo "============================================"
echo "  LandGrant Pre-Push Quality Gate"
echo "============================================"
echo ""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
BACKEND_DIR="$REPO_ROOT/backend"
FRONTEND_DIR="$REPO_ROOT/frontend"

fail() {
    echo ""
    echo -e "${RED}❌ QUALITY GATE FAILED: $1${NC}"
    echo ""
    echo -e "${YELLOW}To bypass (EMERGENCY ONLY):${NC} git push --no-verify"
    echo ""
    exit 1
}

if [ -d "$BACKEND_DIR" ] && command -v python3 >/dev/null 2>&1; then
    echo "Running backend lint (ruff + black)..."
    (cd "$BACKEND_DIR" && python3 -m ruff check app && python3 -m black --check app) \
        || fail "Backend lint failed"

    echo "Running backend fast pytest..."
    (cd "$BACKEND_DIR" && python3 -m pytest -q -x --ignore=tests/rules tests) \
        || fail "Backend pytest failed"
else
    echo -e "${YELLOW}Skipping backend checks (python3 unavailable)${NC}"
fi

if [ -d "$FRONTEND_DIR" ]; then
    cd "$FRONTEND_DIR"
    echo "Running Playwright smoke tests..."
    npm run test:smoke || fail "Playwright smoke failed"
fi

echo ""
echo -e "${GREEN}✅ QUALITY GATE: PASSED${NC}"
echo "============================================"
exit 0
