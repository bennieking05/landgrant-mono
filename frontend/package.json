{
  "name": "landgrant-frontend",
  "private": true,
  "scripts": {
    "dev": "vite --port 3050 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3050 --strictPort",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:evidence": "playwright test tests/evidence/ --project=chromium",
    "test:regression": "playwright test --project=chromium && playwright test tests/evidence/ --project=chromium",
    "test:smoke": "playwright test tests/e2e/landowner.spec.ts --project=chromium",
    "test:gallery": "playwright test tests/e2e/empty-db-gallery.spec.ts --project=chromium",
    "test:a11y": "playwright test tests/e2e/a11y-portal-workbench.spec.ts --project=chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/react": "^8.47.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.1",
    "lucide-react": "0.424.0",
    "mapbox-gl": "^3.3.0",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-i18next": "^15.4.0",
    "react-router-dom": "7.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "20.11.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.17",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.4.5",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
